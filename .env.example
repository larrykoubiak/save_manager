# Copy values you need into your ignored local .env file.
SAVE_MANAGER_PORT=8081
# Browser login: any username, this value as the password.
SAVE_MANAGER_TOKEN=
# Remotely managed Cloudflare Tunnel: token from the tunnel's Docker setup.
CLOUDFLARE_TUNNEL_TOKEN=
# Uncomment after configuring the tunnel token and authentication.
# COMPOSE_PROFILES=cloudflare
# Optional: match restricted card folders to your host user.
# SAVE_MANAGER_UID=1000
# SAVE_MANAGER_GID=1000
